---
import Layout from "@/layouts/Layout.astro"

import FreeAbout from "@/components/sections/FreeAbout.astro"
import FreeHero from "@/components/sections/FreeHero.astro"
import StatsBar from "@/components/sections/StatsBar.astro"
import KeyboardManager from "@/components/KeyboardManager.astro"
import CTAOne from "@/components/sections/CTAOne.astro"
import Results from "@/components/sections/Results.astro"
import Testimonials from "@/components/sections/Testimonials.astro"
import Services from "@/components/sections/Services.astro"
import Process from "@/components/sections/Process.astro"

import { free_basics } from "@cv"
const { name, label } = free_basics
---

<Layout title={`${name} - ${label}`}>
  <main>
    <FreeHero />
    <StatsBar />
    <FreeAbout />
    <Results />
    <Testimonials />
    <Services />
    <Process />
    <CTAOne />
  </main>

  <KeyboardManager />
</Layout>

<style>
  main {
    padding: 4rem;
    margin: auto;
    width: 100%;
  }

  @media (width <= 700px) {
    main {
      padding: 1rem;
    }
  }
</style>
