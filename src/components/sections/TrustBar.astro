---
import Section from "../Section.astro"

import { trust_factors } from "@cv"
---

<Section>
  <ul class="trust">
    {
      trust_factors.map(({ title, detail }) => (
        <li>
          <span class="trust-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path d="M12 2.5l7 3v5.7c0 4.8-3.4 8.2-7 9.8-3.6-1.6-7-5-7-9.8V5.5l7-3z" />
              <path d="M9 12l2 2 4-4" />
            </svg>
          </span>
          <div>
            <strong>{title}</strong>
            <span>{detail}</span>
          </div>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .trust {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem 1rem;
    border: 1px solid #e2e2e2;
    border-radius: 10px;
    padding: 1rem;
    background: #fafafa;
  }

  .trust li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .trust-icon {
    display: inline-flex;
    flex: 0 0 auto;
    color: #2f9e44;
  }

  .trust-icon svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .trust strong {
    display: block;
    color: #111;
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .trust div > span {
    display: block;
    margin-top: 2px;
    color: #777;
    font-size: 0.72rem;
    line-height: 1.4;
  }

  @media (width <= 700px) {
    .trust {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-color-scheme: dark) {
    .trust {
      background: #161616;
      border-color: #333;
    }

    .trust-icon {
      color: #69db7c;
    }

    .trust strong {
      color: #eee;
    }

    .trust div > span {
      color: #999;
    }
  }
</style>
