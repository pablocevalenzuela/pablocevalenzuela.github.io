---
import Section from "../Section.astro"
import { notableAchievements } from "@cv"
---

<Section title="Notable Achievements">
  <ul>
    {
      notableAchievements.map((achievement) => (
        <li>
          <span>● {achievement}</span>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  li {
    font-size: 0.85rem;
    line-height: 1.4;
  }
</style>
