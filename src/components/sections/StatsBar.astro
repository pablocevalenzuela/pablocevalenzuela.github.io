---
import Section from "../Section.astro"

import { stats } from "@cv"
---

<Section>
  <ul class="stats">
    {
      stats.map(({ value, label }) => {
        return (
          <li>
            <span class="stats-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="9" />
                <path d="M8 12l2.5 2.5L16 9" />
              </svg>
            </span>
            <div>
              <strong>{value}</strong>
              <span>{label}</span>
            </div>
          </li>
        )
      })
    }
  </ul>
</Section>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem 1rem;
    border: 1px solid #e2e2e2;
    border-radius: 10px;
    padding: 1rem;
    background: #fafafa;
  }

  .stats li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .stats-icon {
    display: inline-flex;
    flex: 0 0 auto;
    color: #2f9e44;
  }

  .stats-icon svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .stats strong {
    display: block;
    color: #111;
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .stats div > span {
    display: block;
    margin-top: 2px;
    color: #777;
    font-size: 0.72rem;
    line-height: 1.4;
  }

  @media (width <= 700px) {
    .stats {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-color-scheme: dark) {
    .stats {
      background: #161616;
      border-color: #333;
    }

    .stats-icon {
      color: #69db7c;
    }

    .stats strong {
      color: #eee;
    }

    .stats div > span {
      color: #999;
    }
  }
</style>
