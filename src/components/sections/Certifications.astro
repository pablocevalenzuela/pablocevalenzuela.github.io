---
import Section from "../Section.astro"
import { certifications } from "@cv"
---

<Section title="Certifications and Seminars">
  <ul>
    {
      certifications.map(({ name, issuer }) => (
        <li>
          <span>● {name}, {issuer}</span>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  li {
    font-size: 0.85rem;
    line-height: 1.4;
  }
</style>
