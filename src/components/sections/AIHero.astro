---
import Section from "@/components/Section.astro"
import Mail from "@/icons/Mail.astro"
import Phone from "@/icons/Phone.astro"
import LinkedIn from "@/icons/LinkedIn.astro"
import GitHub from "@/icons/GitHub.astro"
import Zoom from "@/icons/Zoom.astro"
import WorldMap from "@/icons/WorldMap.astro"
import type { SocialIcon } from "@/types"

import { free_basics, ai_intro } from "@cv"
const { name, location, profiles, phone, email } = free_basics
const { city, region } = location

const SOCIAL_ICONS: SocialIcon = {
  GitHub,
  LinkedIn,
  Zoom,
}
---

<Section>
  <a href="/" class="back-link" title="Back to home">← Home</a>
  <div class="container">
    <div class="info">
      <h1>Applied AI &amp; Agentic Systems</h1>
      <p class="intro">{ai_intro}</p>
      <div class="meta">
        <span>
          <WorldMap />
          {city}, {region}
        </span>
        <span>
          Spanish - English
        </span>
      </div>
      <footer class="no-print">
        {
          email && (
            <a
              href={`mailto:${email}`}
              title={`Send an email to ${name} at ${email}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Mail />
            </a>
          )
        }
        {
          phone && (
            <a
              href={`tel:${phone}`}
              title={`Call ${name} at ${phone}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Phone />
            </a>
          )
        }
        {
          profiles.map(({ network, url }) => {
            const Icon = SOCIAL_ICONS[network]

            return (
              <a
                href={url}
                title={`Visit the ${name} profile on ${network}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                <Icon />
              </a>
            )
          })
        }
      </footer>
    </div>
  </div>
</Section>

<style>
  .back-link {
    display: inline-block;
    margin-bottom: 1rem;
    color: #777;
    font-size: 0.85rem;
    text-decoration: none;
  }

  .back-link:hover {
    color: #111;
  }

  .container {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  h1 {
    font-size: 2rem;
    line-height: 1.25;
  }

  .intro {
    color: #333;
    font-weight: 500;
    font-size: 0.95rem;
    text-wrap: balance;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-top: 4px;
  }

  .meta span {
    color: #666;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.85rem;
    letter-spacing: -0.05rem;
  }

  footer {
    color: #555;
    font-size: 0.65rem;
    display: flex;
    gap: 4px;
    margin-top: 8px;
  }

  footer a {
    color: #777;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #eee;
    padding: 4px;
    height: 32px;
    width: 32px;
    border-radius: 6px;
    transition: all 0.3s ease;
  }

  footer a:hover {
    background: #eee;
    border: 1px solid #ddd;
  }

  @media (width <= 700px) {
    .info {
      justify-content: center;
      align-items: center;
      padding-right: 0;
      text-align: center;
    }

    .back-link {
      text-align: center;
      width: 100%;
    }

    .meta {
      justify-content: center;
    }
  }

  @media (prefers-color-scheme: dark) {
    .back-link {
      color: #888;
    }

    .back-link:hover {
      color: #eee;
    }

    .intro {
      color: #ccc;
    }

    .meta span {
      color: #999;
    }

    footer a {
      color: #aaa;
      border-color: #333;
    }

    footer a:hover {
      background: #222;
      border-color: #eee;
    }
  }
</style>