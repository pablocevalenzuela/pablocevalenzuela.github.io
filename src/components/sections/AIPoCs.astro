---
import Section from "../Section.astro"

import { ai_pocs, ai_stack } from "@cv"
---

<Section title="AI Proofs of Concept">
  <ul class="poc-grid">
    {
      ai_pocs.map(({ title, status, description, metrics, use_cases, benefits, tags, url, video }) => {
        return (
          <li>
            <article class="poc-card">
              <div class="poc-head">
                <h4>{title}</h4>
                {status && <span class="status">{status}</span>}
              </div>
              <p>{description}</p>
              {use_cases && use_cases.length > 0 && (
                <div class="use-cases">
                  <span class="use-cases-title">Use cases</span>
                  <ul>
                    {
                      use_cases.map((item: string) => (
                        <li>{item}</li>
                      ))
                    }
                  </ul>
                </div>
              )}
              {benefits && benefits.length > 0 && (
                <div class="benefits">
                  <span class="benefits-title">Benefits</span>
                  <ul>
                    {
                      benefits.map((item: string) => (
                        <li>{item}</li>
                      ))
                    }
                  </ul>
                </div>
              )}
              {metrics && metrics.length > 0 && (
                <div class="metrics">
                  <span class="metrics-title">Metrics</span>
                  <ul class="metrics-grid">
                    {
                      metrics.map((m) => (
                        <li>
                          <strong>{m.value}</strong>
                          <span>{m.label}</span>
                        </li>
                      ))
                    }
                  </ul>
                </div>
              )}
              {tags && tags.length > 0 && (
                <ul class="tags">
                  {tags.map((tag: string) => (
                    <li>{tag}</li>
                  ))}
                </ul>
              )}
              <div class="poc-actions">
                {video && (
                  <button
                    type="button"
                    class="ai-demo-btn"
                    data-video={`/videos/${video}`}
                    aria-label={`View project demo of ${title}`}
                  >
                    <svg class="play-icon" viewBox="0 0 24 24" aria-hidden="true">
                      <polygon points="7,4 20,12 7,20" />
                    </svg>
                    View demo
                  </button>
                )}
                {url && (
                  <a
                    href={url}
                    class="poc-link"
                    title={`View source code: ${title}`}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    View on GitHub
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M7 17 17 7M9 7h8v8" />
                    </svg>
                  </a>
                )}
              </div>
            </article>
          </li>
        )
      })
    }
  </ul>
</Section>

<Section title="AI Stack">
  <ul class="stack-chips">
    {
      ai_stack.map((item: string) => (
        <li>{item}</li>
      ))
    }
  </ul>
</Section>

<dialog id="ai-video-dialog">
  <button type="button" class="dialog-close" aria-label="Close video">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M6 6l12 12M18 6L6 18" />
    </svg>
  </button>
  <video id="ai-demo-video" controls playsinline preload="metadata"></video>
</dialog>

<script>
  const dialog = document.getElementById("ai-video-dialog") as HTMLDialogElement
  const video = document.getElementById("ai-demo-video") as HTMLVideoElement

  const buttons = document.querySelectorAll<HTMLButtonElement>(".ai-demo-btn")
  const closeButton = dialog.querySelector<HTMLButtonElement>(".dialog-close")

  if (!dialog || !video || !closeButton) throw new Error("AI video dialog elements missing")

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const src = button.dataset.video
      if (!src) return
      video.src = src
      dialog.showModal()
      video.play()
    })
  })

  const closeAndPause = () => {
    video.pause()
    video.removeAttribute("src")
    dialog.close()
  }

  closeButton.addEventListener("click", closeAndPause)

  dialog.addEventListener("click", (event) => {
    if (event.target === dialog) closeAndPause()
  })

  dialog.addEventListener("close", () => {
    video.pause()
    video.removeAttribute("src")
  })
</script>

<style>
  .poc-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .poc-grid > li {
    display: flex;
  }

  .poc-card {
    flex: 1;
    display: flex;
    flex-direction: column;
    border: 1px solid #e2e2e2;
    border-radius: 10px;
    padding: 1rem;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .poc-card:hover {
    border-color: #ccc;
    transform: translateY(-2px);
  }

  .poc-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    margin-bottom: 0.5rem;
  }

  h4 {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 700;
    color: #222;
    line-height: 1.4;
  }

  .status {
    font-size: 0.68rem;
    color: #555;
    background: #fafafa;
    border: 1px solid #e4e4e4;
    border-radius: 999px;
    padding: 2px 8px;
    white-space: nowrap;
  }

  .metrics {
    margin: 0.75rem 0;
    padding: 0.75rem 0;
    border-top: 1px solid #f0f0f0;
    border-bottom: 1px solid #f0f0f0;
  }

  .metrics-title {
    display: block;
    margin-bottom: 6px;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.02rem;
    color: #777;
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
    gap: 0.5rem;
  }

  .metrics-grid li {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .metrics-grid strong {
    font-size: 1.1rem;
    font-weight: 800;
    color: #111;
    line-height: 1.2;
    letter-spacing: -0.03rem;
  }

  .metrics-grid span {
    font-size: 0.68rem;
    color: #777;
    text-transform: uppercase;
    letter-spacing: 0.02rem;
    line-height: 1.3;
  }

  .use-cases {
    margin: 0.5rem 0;
    padding-top: 0.5rem;
    border-top: 1px solid #f0f0f0;
  }

  .use-cases-title {
    display: block;
    margin-bottom: 4px;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.02rem;
    color: #777;
  }

  .use-cases ul {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .use-cases li {
    color: #666;
    font-size: 0.82rem;
    line-height: 1.4;
    padding-left: 0.75rem;
    position: relative;
  }

  .use-cases li::before {
    content: "▸";
    position: absolute;
    left: 0;
    color: #999;
  }

  .benefits {
    margin: 0.5rem 0;
    padding-top: 0.5rem;
    border-top: 1px solid #f0f0f0;
  }

  .benefits-title {
    display: block;
    margin-bottom: 4px;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.02rem;
    color: #777;
  }

  .benefits ul {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .benefits li {
    color: #666;
    font-size: 0.82rem;
    line-height: 1.4;
    padding-left: 1rem;
    position: relative;
  }

  .benefits li::before {
    content: "✓";
    position: absolute;
    left: 0.15rem;
    color: #2f9e44;
    font-weight: 700;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin: 0.5rem 0;
  }

  .tags li {
    font-size: 0.68rem;
    color: #555;
    background: #fafafa;
    border: 1px solid #e4e4e4;
    border-radius: 999px;
    padding: 2px 8px;
  }

  .poc-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: auto;
    padding-top: 0.75rem;
  }

  .ai-demo-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    background: transparent;
    border: 1px solid #e2e2e2;
    border-radius: 6px;
    color: #111;
    font-family: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .ai-demo-btn:hover {
    background: #f5f5f5;
    border-color: #111;
  }

  .play-icon {
    width: 14px;
    height: 14px;
    fill: currentColor;
  }

  .poc-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: #111;
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
  }

  .poc-link svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.2s ease;
  }

  .poc-link:hover {
    text-decoration: underline;
  }

  .poc-link:hover svg {
    transform: translateX(4px);
  }

  .stack-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .stack-chips li {
    font-size: 0.8rem;
    color: #444;
    background: #fafafa;
    border: 1px solid #e4e4e4;
    border-radius: 999px;
    padding: 6px 14px;
    letter-spacing: -0.01rem;
  }

  dialog {
    border: none;
    border-radius: 10px;
    padding: 0;
    max-width: min(92vw, 880px);
    width: 100%;
    background: #111;
    box-shadow: 0 12px 40px rgb(0 0 0 / 0.5);
  }

  dialog::backdrop {
    background: rgb(0 0 0 / 0.75);
  }

  #ai-demo-video {
    display: block;
    width: 100%;
    border-radius: 10px;
    aspect-ratio: 16 / 9;
    background: #000;
  }

  .dialog-close {
    position: absolute;
    top: 10px;
    right: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border: none;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.55);
    color: #fff;
    cursor: pointer;
    transition: background 0.2s ease;
    z-index: 1;
  }

  .dialog-close:hover {
    background: rgb(0 0 0 / 0.85);
  }

  .dialog-close svg {
    width: 14px;
    height: 14px;
    stroke: currentColor;
    stroke-width: 2;
    fill: none;
    stroke-linecap: round;
  }

  @media (width <= 700px) {
    .poc-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-color-scheme: dark) {
    .poc-card {
      border-color: #333;
    }

    .poc-card:hover {
      border-color: #eee;
    }

    h4 {
      color: #eee;
    }

    .status {
      background: #1a1a1a;
      border-color: #333;
      color: #aaa;
    }

    .metrics {
      border-color: #2a2a2a;
    }

    .metrics-title {
      color: #999;
    }

    .metrics-grid strong {
      color: #eee;
    }

    .metrics-grid span {
      color: #999;
    }

    .use-cases {
      border-top-color: #2a2a2a;
    }

    .use-cases-title {
      color: #999;
    }

    .use-cases li {
      color: #999;
    }

    .use-cases li::before {
      color: #666;
    }

    .benefits {
      border-top-color: #2a2a2a;
    }

    .benefits-title {
      color: #999;
    }

    .benefits li {
      color: #999;
    }

    .benefits li::before {
      color: #69db7c;
    }

    .tags li {
      background: #1a1a1a;
      border-color: #333;
      color: #aaa;
    }

    .poc-link {
      color: #eee;
    }

    .ai-demo-btn {
      color: #eee;
      border-color: #333;
    }

    .ai-demo-btn:hover {
      background: #222;
      border-color: #eee;
    }

    .stack-chips li {
      background: #1a1a1a;
      border-color: #333;
      color: #ccc;
    }
  }
</style>