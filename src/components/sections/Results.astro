---
import Section from "../Section.astro"

import { results, cta_one } from "@cv"
---

<Section title="Some results obtained">
  <ul class="results-grid">
    {
      results.map(({ company, project, tags, metrics, desc, desc2, video }) => {
        return (
          <li>
            <article class="result-card">
              {tags.length > 0 && (
                <ul class="tags">
                  {
                    tags.map((tag: string) => (
                      <li>{tag}</li>
                    ))
                  }
                </ul>
              )}
              <h4>{company}</h4>
              <p class="project">{project}</p>
              {metrics.length > 0 && (
                <ul class="metrics">
                  {
                    metrics.map((m) => (
                      <li>
                        <strong>{m.value}</strong>
                        <span>{m.label}</span>
                      </li>
                    ))
                  }
                </ul>
              )}
              <p>{desc}</p>
              {desc2 && (
                <details class="tech-details">
                  <summary>Technical details</summary>
                  <p>{desc2}</p>
                </details>
              )}
              <div class="actions">
                <button
                  type="button"
                  class={video ? "demo-btn" : "demo-btn demo-btn--empty"}
                  data-video={video ? `/videos/${video}` : ""}
                  aria-label={video ? `View project demo of ${company}` : `Video not available for ${company}`}
                >
                  <svg class="play-icon" viewBox="0 0 24 24" aria-hidden="true">
                    <polygon points="7,4 20,12 7,20" />
                  </svg>
                  View project
                </button>
                <a
                  href={cta_one.url}
                  class="card-cta"
                  title="Get similar results: book a meeting"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Get similar results
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M5 12h14M13 6l6 6-6 6" />
                  </svg>
                </a>
              </div>
            </article>
          </li>
        )
      })
    }
  </ul>

  <dialog id="video-dialog">
    <button type="button" class="dialog-close" aria-label="Close video">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
    <video id="demo-video" controls playsinline preload="metadata"></video>
  </dialog>
</Section>

<script>
  const dialog = document.getElementById("video-dialog") as HTMLDialogElement
  const video = document.getElementById("demo-video") as HTMLVideoElement

  const buttons = document.querySelectorAll<HTMLButtonElement>(".demo-btn")
  const closeButton = dialog.querySelector<HTMLButtonElement>(".dialog-close")

  if (!dialog || !video || !closeButton) throw new Error("Video dialog elements missing")

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const src = button.dataset.video
      if (!src) return
      video.src = src
      dialog.showModal()
      video.play()
    })
  })

  const closeAndPause = () => {
    video.pause()
    video.removeAttribute("src")
    dialog.close()
  }

  closeButton.addEventListener("click", closeAndPause)

  dialog.addEventListener("click", (event) => {
    if (event.target === dialog) closeAndPause()
  })

  dialog.addEventListener("close", () => {
    video.pause()
    video.removeAttribute("src")
  })
</script>

<style>
  .results-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .results-grid > li {
    display: flex;
  }

  .result-card {
    flex: 1;
    display: flex;
    flex-direction: column;
    border: 1px solid #e2e2e2;
    border-radius: 10px;
    padding: 1rem;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .result-card:hover {
    border-color: #ccc;
    transform: translateY(-2px);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-bottom: 0.5rem;
  }

  .tags li {
    font-size: 0.68rem;
    color: #555;
    background: #fafafa;
    border: 1px solid #e4e4e4;
    border-radius: 999px;
    padding: 2px 8px;
  }

  h4 {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 700;
    color: #222;
    line-height: 1.4;
  }

  .project {
    margin-top: 0.25rem;
    color: #777;
    font-size: 0.78rem;
    text-wrap: balance;
  }

  .metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
    gap: 0.5rem;
    margin: 0.75rem 0;
    padding: 0.75rem 0;
    border-top: 1px solid #f0f0f0;
    border-bottom: 1px solid #f0f0f0;
  }

  .metrics li {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .metrics strong {
    font-size: 1.25rem;
    font-weight: 800;
    color: #111;
    line-height: 1.2;
    letter-spacing: -0.03rem;
  }

  .metrics span {
    font-size: 0.68rem;
    color: #777;
    text-transform: uppercase;
    letter-spacing: 0.02rem;
    line-height: 1.3;
  }

  .tech-details {
    margin-top: 0.5rem;
  }

  .tech-details summary {
    cursor: pointer;
    color: #555;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .tech-details summary:hover {
    text-decoration: underline;
  }

  .tech-details p {
    margin-top: 0.5rem;
    font-size: 0.82rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: auto;
    padding-top: 0.75rem;
  }

  .demo-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    background: transparent;
    border: 1px solid #e2e2e2;
    border-radius: 6px;
    color: #111;
    font-family: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .demo-btn:hover {
    background: #f5f5f5;
    border-color: #111;
  }

  .demo-btn--empty {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .demo-btn--empty:hover {
    background: transparent;
    border-color: #e2e2e2;
  }

  .play-icon {
    width: 14px;
    height: 14px;
    fill: currentColor;
  }

  .card-cta {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: #111;
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
  }

  .card-cta svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.2s ease;
  }

  .card-cta:hover {
    text-decoration: underline;
  }

  .card-cta:hover svg {
    transform: translateX(4px);
  }

  dialog {
    border: none;
    border-radius: 10px;
    padding: 0;
    max-width: min(92vw, 880px);
    width: 100%;
    background: #111;
    box-shadow: 0 12px 40px rgb(0 0 0 / 0.5);
  }

  dialog::backdrop {
    background: rgb(0 0 0 / 0.75);
  }

  #demo-video {
    display: block;
    width: 100%;
    border-radius: 10px;
    aspect-ratio: 16 / 9;
    background: #000;
  }

  .dialog-close {
    position: absolute;
    top: 10px;
    right: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border: none;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.55);
    color: #fff;
    cursor: pointer;
    transition: background 0.2s ease;
    z-index: 1;
  }

  .dialog-close:hover {
    background: rgb(0 0 0 / 0.85);
  }

  .dialog-close svg {
    width: 14px;
    height: 14px;
    stroke: currentColor;
    stroke-width: 2;
    fill: none;
    stroke-linecap: round;
  }

  @media (width <= 700px) {
    .results-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-color-scheme: dark) {
    .result-card {
      border-color: #333;
    }

    .result-card:hover {
      border-color: #eee;
    }

    .tags li {
      background: #1a1a1a;
      border-color: #333;
      color: #aaa;
    }

    h4 {
      color: #eee;
    }

    .project {
      color: #888;
    }

    .metrics {
      border-color: #2a2a2a;
    }

    .metrics strong {
      color: #eee;
    }

    .metrics span {
      color: #999;
    }

    .tech-details summary {
      color: #aaa;
    }

    .demo-btn {
      color: #eee;
      border-color: #333;
    }

    .demo-btn:hover {
      background: #222;
      border-color: #eee;
    }

    .card-cta {
      color: #eee;
    }
  }
</style>