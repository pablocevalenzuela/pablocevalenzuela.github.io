---
import Section from "../Section.astro"

import { results, cta_one } from "@cv"
---

<Section title="Portfolio & results obtained">
  <ul class="results-grid">
    {
      results.map(({ company, project, tags, metrics, security, reliability, security_details, tech, duration, delivery_status, desc, benefits, desc2, url, video }) => {
        return (
          <li>
            <article class="result-card">
              {tags.length > 0 && (
                <ul class="tags">
                  {
                    tags.map((tag: string) => (
                      <li>{tag}</li>
                    ))
                  }
                </ul>
              )}
              <h4>{company}</h4>
              <p class="project">{project}</p>
              {benefits && benefits.length > 0 ? (
                <div class="benefits">
                  <span class="benefits-title">Benefits</span>
                  <ul>
                    {benefits.map((item: string) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              ) : (
                <p>{desc}</p>
              )}
              {metrics.length > 0 && (
                <div class="metrics">
                  <span class="metrics-title">Metrics</span>
                  <ul class="metrics-grid">
                    {
                      metrics.map((m) => (
                        <li>
                          <strong>{m.value}</strong>
                          <span>{m.label}</span>
                        </li>
                      ))
                    }
                  </ul>
                </div>
              )}
              {((security && security.length > 0) || (reliability && reliability.length > 0)) && (
                <div class="trust-block">
                  <span class="trust-block-title">Security &amp; operational stability</span>
                  <div class="trust-cols">
                    {security && security.length > 0 && (
                      <div class="trust-col">
                        <span class="trust-col-title">
                          <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 2.5l7 3v5.7c0 4.8-3.4 8.2-7 9.8-3.6-1.6-7-5-7-9.8V5.5l7-3z" />
                            <path d="M9 12l2 2 4-4" />
                          </svg>
                          Security
                        </span>
                        <ul>
                          {security.map((item: string) => (
                            <li>{item}</li>
                          ))}
                        </ul>
                      </div>
                    )}
                    {reliability && reliability.length > 0 && (
                      <div class="trust-col">
                        <span class="trust-col-title">
                          <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M3 12h4l2.5-6 4 12 2.5-6h5" />
                          </svg>
                          Operational stability
                        </span>
                        <ul>
                          {reliability.map((item: string) => (
                            <li>{item}</li>
                          ))}
                        </ul>
                      </div>
                    )}
                  </div>
                </div>
              )}
              {tech && tech.length > 0 && (
                <div class="tech-used">
                  <span class="tech-title">Technology used</span>
                  <ul class="tech-chips">
                    {tech.map((item: string) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              )}
              {(duration || delivery_status) && (
                <div class="project-time">
                  {duration ? (
                    <>
                      <span class="time-title">Project duration</span>
                      <span class="time-value">{duration}</span>
                    </>
                  ) : (
                    <span class="time-title">Delivery status</span>
                  )}
                  {delivery_status && <span class="time-status">{delivery_status}</span>}
                </div>
              )}
              {(security_details || desc2) && (
                <details class="tech-details">
                  <summary>Security &amp; operations details</summary>
                  {security_details && (
                    <div class="detail-group">
                      <span class="detail-title">Security</span>
                      <p>{security_details}</p>
                    </div>
                  )}
                  {desc2 && (
                    <div class="detail-group">
                      <span class="detail-title">Operational stability</span>
                      <p>{desc2}</p>
                    </div>
                  )}
                </details>
              )}
              <div class="actions">
                <button
                  type="button"
                  class={video ? "demo-btn" : "demo-btn demo-btn--empty"}
                  data-video={video ? `/videos/${video}` : ""}
                  aria-label={video ? `View project demo of ${company}` : `Video not available for ${company}`}
                >
                  <svg class="play-icon" viewBox="0 0 24 24" aria-hidden="true">
                    <polygon points="7,4 20,12 7,20" />
                  </svg>
                  View project
                </button>
                <a
                  href={cta_one.url}
                  class="card-cta"
                  title="Get similar results: book a meeting"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Get similar results
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M5 12h14M13 6l6 6-6 6" />
                  </svg>
                </a>
                {url && (
                  <a
                    href={url}
                    class="card-cta"
                    title={`View source code: ${company}`}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    View on GitHub
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M7 17 17 7M9 7h8v8" />
                    </svg>
                  </a>
                )}
              </div>
            </article>
          </li>
        )
      })
    }
  </ul>

  <dialog id="video-dialog">
    <button type="button" class="dialog-close" aria-label="Close video">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
    <video id="demo-video" controls playsinline preload="metadata"></video>
  </dialog>
</Section>

<script>
  const dialog = document.getElementById("video-dialog") as HTMLDialogElement
  const video = document.getElementById("demo-video") as HTMLVideoElement

  const buttons = document.querySelectorAll<HTMLButtonElement>(".demo-btn")
  const closeButton = dialog.querySelector<HTMLButtonElement>(".dialog-close")

  if (!dialog || !video || !closeButton) throw new Error("Video dialog elements missing")

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const src = button.dataset.video
      if (!src) return
      video.src = src
      dialog.showModal()
      video.play()
    })
  })

  const closeAndPause = () => {
    video.pause()
    video.removeAttribute("src")
    dialog.close()
  }

  closeButton.addEventListener("click", closeAndPause)

  dialog.addEventListener("click", (event) => {
    if (event.target === dialog) closeAndPause()
  })

  dialog.addEventListener("close", () => {
    video.pause()
    video.removeAttribute("src")
  })
</script>

<style>
  .results-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .results-grid > li {
    display: flex;
  }

  .result-card {
    flex: 1;
    display: flex;
    flex-direction: column;
    border: 1px solid #e2e2e2;
    border-radius: 10px;
    padding: 1rem;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .result-card:hover {
    border-color: #ccc;
    transform: translateY(-2px);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-bottom: 0.5rem;
  }

  .tags li {
    font-size: 0.68rem;
    color: #555;
    background: #fafafa;
    border: 1px solid #e4e4e4;
    border-radius: 999px;
    padding: 2px 8px;
  }

  h4 {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 700;
    color: #222;
    line-height: 1.4;
  }

  .project {
    margin-top: 0.25rem;
    color: #777;
    font-size: 0.78rem;
    text-wrap: balance;
  }

  .benefits {
    margin: 0.5rem 0;
    padding-top: 0.5rem;
    border-top: 1px solid #f0f0f0;
  }

  .benefits-title,
  .metrics-title,
  .trust-block-title,
  .tech-title,
  .time-title {
    display: block;
    margin-bottom: 4px;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.02rem;
    color: #777;
  }

  .benefits ul {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .benefits li {
    color: #777;
    font-size: 0.78rem;
    line-height: 1.5;
    padding-left: 1rem;
    position: relative;
  }

  .benefits li::before {
    content: "✓";
    position: absolute;
    left: 0.15rem;
    color: #2f9e44;
    font-weight: 700;
  }

  .metrics {
    margin: 0.75rem 0;
    padding: 0.75rem 0;
    border-top: 1px solid #f0f0f0;
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
    gap: 0.5rem;
  }

  .metrics-grid li {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .metrics-grid strong {
    font-size: 1.25rem;
    font-weight: 800;
    color: #111;
    line-height: 1.2;
    letter-spacing: -0.03rem;
  }

  .metrics-grid span {
    font-size: 0.68rem;
    color: #777;
    text-transform: uppercase;
    letter-spacing: 0.02rem;
    line-height: 1.3;
  }

  .trust-block {
    margin: 0.5rem 0;
    padding-top: 0.5rem;
    border-top: 1px solid #f0f0f0;
  }

  .trust-cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 0.5rem;
  }

  .trust-col-title {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-bottom: 4px;
    color: #444;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02rem;
  }

  .trust-col-title svg {
    width: 12px;
    height: 12px;
    flex: 0 0 auto;
    fill: none;
    stroke: #2f9e44;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .trust-col ul {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .trust-col li {
    position: relative;
    padding-left: 0.75rem;
    color: #777;
    font-size: 0.72rem;
    line-height: 1.4;
  }

  .trust-col li::before {
    content: "›";
    position: absolute;
    left: 0;
    color: #999;
  }

  .tech-used,
  .project-time {
    margin: 0.5rem 0;
    padding-top: 0.5rem;
    border-top: 1px solid #f0f0f0;
  }

  .tech-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .tech-chips li {
    font-size: 0.68rem;
    color: #555;
    background: #fafafa;
    border: 1px solid #e4e4e4;
    border-radius: 999px;
    padding: 2px 8px;
  }

  .time-value {
    display: block;
    margin-top: 2px;
    color: #111;
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .time-status {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-top: 4px;
    color: #2f9e44;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .time-status::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #2f9e44;
  }

  .tech-details {
    margin-top: 0.5rem;
  }

  .tech-details summary {
    cursor: pointer;
    color: #555;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .tech-details summary:hover {
    text-decoration: underline;
  }

  .tech-details p {
    margin-top: 0;
    color: #777;
    font-size: 0.78rem;
    line-height: 1.5;
  }

  .detail-group {
    margin-top: 0.5rem;
  }

  .detail-title {
    display: block;
    margin-bottom: 2px;
    color: #555;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: auto;
    padding-top: 0.75rem;
  }

  .demo-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    background: transparent;
    border: 1px solid #e2e2e2;
    border-radius: 6px;
    color: #111;
    font-family: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .demo-btn:hover {
    background: #f5f5f5;
    border-color: #111;
  }

  .demo-btn--empty {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .demo-btn--empty:hover {
    background: transparent;
    border-color: #e2e2e2;
  }

  .play-icon {
    width: 14px;
    height: 14px;
    fill: currentColor;
  }

  .card-cta {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: #111;
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
  }

  .card-cta svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.2s ease;
  }

  .card-cta:hover {
    text-decoration: underline;
  }

  .card-cta:hover svg {
    transform: translateX(4px);
  }

  dialog {
    border: none;
    border-radius: 10px;
    padding: 0;
    max-width: min(92vw, 880px);
    width: 100%;
    background: #111;
    box-shadow: 0 12px 40px rgb(0 0 0 / 0.5);
  }

  dialog::backdrop {
    background: rgb(0 0 0 / 0.75);
  }

  #demo-video {
    display: block;
    width: 100%;
    border-radius: 10px;
    aspect-ratio: 16 / 9;
    background: #000;
  }

  .dialog-close {
    position: absolute;
    top: 10px;
    right: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border: none;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.55);
    color: #fff;
    cursor: pointer;
    transition: background 0.2s ease;
    z-index: 1;
  }

  .dialog-close:hover {
    background: rgb(0 0 0 / 0.85);
  }

  .dialog-close svg {
    width: 14px;
    height: 14px;
    stroke: currentColor;
    stroke-width: 2;
    fill: none;
    stroke-linecap: round;
  }

  @media (width <= 700px) {
    .results-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-color-scheme: dark) {
    .result-card {
      border-color: #333;
    }

    .result-card:hover {
      border-color: #eee;
    }

    .tags li {
      background: #1a1a1a;
      border-color: #333;
      color: #aaa;
    }

    h4 {
      color: #eee;
    }

    .project {
      color: #888;
    }

    .benefits {
      border-top-color: #2a2a2a;
    }

    .benefits-title,
    .metrics-title,
    .trust-block-title,
    .tech-title,
    .time-title {
      color: #999;
    }

    .benefits li {
      color: #888;
    }

    .benefits li::before {
      color: #69db7c;
    }

    .metrics {
      border-color: #2a2a2a;
    }

    .metrics-grid strong {
      color: #eee;
    }

    .metrics-grid span {
      color: #999;
    }

    .trust-block {
      border-top-color: #2a2a2a;
    }

    .trust-col-title {
      color: #aaa;
    }

    .trust-col-title svg {
      stroke: #69db7c;
    }

    .trust-col li {
      color: #888;
    }

    .trust-col li::before {
      color: #666;
    }

    .tech-used,
    .project-time {
      border-top-color: #2a2a2a;
    }

    .tech-chips li {
      background: #1a1a1a;
      border-color: #333;
      color: #aaa;
    }

    .time-value {
      color: #eee;
    }

    .time-status {
      color: #69db7c;
    }

    .time-status::before {
      background: #69db7c;
    }

    .tech-details summary {
      color: #aaa;
    }

    .tech-details p {
      color: #888;
    }

    .detail-title {
      color: #aaa;
    }

    .demo-btn {
      color: #eee;
      border-color: #333;
    }

    .demo-btn:hover {
      background: #222;
      border-color: #eee;
    }

    .card-cta {
      color: #eee;
    }
  }
</style>